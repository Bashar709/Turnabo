# Kopier denne fila til .env.local og fyll inn egne nøkler etter hvert.

# Google Places API – for ekte bilder og fasilitetsdata
GOOGLE_PLACES_API_KEY=

# Nasjonal Turbase / UT.no – for ekte turdata (søknad om tilgang på turbase.no)
NASJONAL_TURBASE_API_KEY=

# MET Norway sitt Locationforecast-API krever INGEN nøkkel, kun en
# identifiserbar User-Agent-header (allerede satt i src/app/api/weather/route.ts).
# Bytt gjerne ut kontakt-e-posten der med din egen.
